# Local development only. Deployed builds ignore these and derive the backend
# from the frontend hostname (sibling `back`, same rules as resolveBackHost.js).
# Hosts are allowlisted — do not point ABR_URL at an arbitrary server.
# Do not put secrets or tokens here.

# Default: b1
ABR_URL=b1-back.nipoto.pro
ABR_WS_URL=wss://b1-back.nipoto.pro

# b5
# ABR_URL=b5-back.nipoto.pro
# ABR_WS_URL=wss://b5-back.nipoto.pro

# stage2
# ABR_URL=back-stage2.nipoto.pro
# ABR_WS_URL=wss://back-stage2.nipoto.pro
